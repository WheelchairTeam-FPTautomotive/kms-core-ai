# KMS Core AI — Environment Variables
# Copy this file to .env and fill in your actual values

OPENAI_API_KEY=sk-...
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=automotive_manuals
PORT=8001
LOG_LEVEL=INFO

# AWS & OpenSearch Configuration
AWS_REGION=ap-southeast-2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

OPENSEARCH_ENDPOINT=https://xxxxxx.ap-southeast-2.aoss.amazonaws.com
OPENSEARCH_INDEX=automotive-manuals

BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

VECTOR_DB_TYPE=chroma

# Hackathon corpus (recursive ingest via rglob)
# DOCS_PDF_DIR=H:\.HACKATHON\docs_pdf
# DOCS_CORPUS_DIR=H:\.HACKATHON\docs_corpus

# ------------------------------------------------------------------------------
# Unified answer generation (driver-facing)
# LLM_PROVIDER: none | bedrock | openai_compatible | ollama
# Answer language follows request `language` (vi|en) from UI — not query language
# ------------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=400
LLM_TOP_P=0.9
RAG_TOP_K=3
RAG_CONTEXT_CHARS=2400

# Chroma L2 relevance gate — reject weak neighbors (forces not_found instead of wrong-PDF answers)
RAG_MAX_DISTANCE=1.15

# Conditional LLM rewrite when first-pass gate keeps 0 (VI→EN OEM manuals)
RAG_REWRITE_ON_MISS=true
RAG_REWRITE_TIMEOUT_S=4
RAG_PLANNER_ENABLED=true
RAG_PLANNER_TIMEOUT_S=4

# Hybrid PDF extract: PyMuPDF first; RapidOCR only on thin/junk pages
PDF_OCR_ON_THIN_PAGE=true
PDF_OCR_DPI=200

# OpenAI-compatible local/cloud endpoint examples:
# Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.2
# LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1   OPENAI_MODEL=<loaded-model>
OPENAI_BASE_URL=
OPENAI_MODEL=llama3.2
