# ------------------------------------------------------------------------------
# KMS Core AI — Environment Template (locked deploy Acc→Lat→Budget)
# ------------------------------------------------------------------------------
# Copy to .env. Prod lock: Chroma on-box + Bedrock Nemotron primary.
# Verify BEDROCK_MODEL_ID in AWS Console for your region before first invoke
# (some models need inference-profile prefixes; Nemotron Super 120B supports
# in-region ID nvidia.nemotron-super-3-120b in ap-southeast-2 per AWS docs).
# ------------------------------------------------------------------------------

PORT=8001
LOG_LEVEL=INFO

# --- RAG (locked: on-box Chroma; AOSS deferred) ---
VECTOR_DB_TYPE=chroma
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=automotive_manuals

# Corpus paths (EC2: under /opt/kms/... or synced from S3 manuals bucket)
# DOCS_PDF_DIR=data/docs_pdf
# DOCS_CORPUS_DIR=data/docs_corpus

# --- Answer LLM (locked primary) ---
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=nvidia.nemotron-super-3-120b
AWS_REGION=ap-southeast-2
# Instance profile preferred on EC2; leave empty when using IAM role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=400
LLM_TOP_P=0.9
RAG_TOP_K=3
RAG_CONTEXT_CHARS=2400
RAG_MAX_DISTANCE=1.15
RAG_REWRITE_ON_MISS=true
RAG_REWRITE_TIMEOUT_S=4
RAG_PLANNER_ENABLED=true
RAG_PLANNER_TIMEOUT_S=4
PDF_OCR_ON_THIN_PAGE=true
PDF_OCR_DPI=200

# --- Budget fallback (Acc-tied; Lat weaker) — uncomment to override primary ---
# LLM_PROVIDER=ollama
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:7b-instruct

# OpenAI-compatible defaults (used when LLM_PROVIDER=ollama|openai_compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:7b-instruct

# --- AOSS deferred (do not enable for v1 Budget lock) ---
# VECTOR_DB_TYPE=opensearch
# OPENSEARCH_ENDPOINT=https://xxxxxx.ap-southeast-2.aoss.amazonaws.com
# OPENSEARCH_INDEX=automotive-manuals
